# GANGU Environment Variables Template
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control.

# Required: Google Gemini powers the agent pipeline
GEMINI_API_KEY=your_gemini_api_key_here
# Multiple keys may be comma-separated in GEMINI_API_KEYS.
# GEMINI_API_KEYS=key_one,key_two
LLM_MODEL=gemini-3.6-flash

# Optional: LangSmith for tracing (set LANGSMITH_TRACING=false to disable)
# Get a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=GANGU

# Optional: Zepto MCP Configuration
ZEPTO_PHONE_NUMBER=your_10_digit_phone_number
ZEPTO_DEFAULT_ADDRESS=Home

# Optional: OpenAI (used only for Whisper voice transcription)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Durable API state (recommended for production and multiple API workers)
# Keep `memory` for local development; use `mongodb` in production.
GANGU_STATE_BACKEND=memory
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=gangu

# Deployment — used in production (Render reads PORT automatically)
# PORT=8000
# FRONTEND_URLS=https://gangu.vercel.app

# Authentication is fail-closed. Set the Firebase project used by the frontend.
GANGU_AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=gangu-adffd
# Optional but recommended in production; provide as a single-line JSON secret.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Safety: when true, Zepto purchases are simulated, never placed
GANGU_DRY_RUN=true
# Real purchasing requires both flags plus a verified live-data product source.
ENABLE_REAL_PURCHASES=false

# Swiggy OAuth/MCP (set after Swiggy approves the exact deployed callback URL)
# SWIGGY_CLIENT_ID=provided_by_swiggy
# SWIGGY_REDIRECT_URI=https://your-api.example.com/api/auth/callback/swiggy
# Required with MongoDB state; generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SWIGGY_TOKEN_ENCRYPTION_KEY=generated_fernet_key
