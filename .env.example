# GANGU Environment Variables Template
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control.

# Required: TokenRouter (OpenAI-compatible) — serves Claude Haiku 4.5
# Get a key at https://tokenrouter.com
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=claude-haiku-4-5

# Optional: LangSmith for tracing (set LANGSMITH_TRACING=false to disable)
# Get a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=GANGU

# Optional: Zepto MCP Configuration
ZEPTO_PHONE_NUMBER=your_10_digit_phone_number
ZEPTO_DEFAULT_ADDRESS=Home

# Optional: OpenAI (used only for Whisper voice transcription)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB (uses default if not set)
MONGODB_URI=mongodb://localhost:27017
