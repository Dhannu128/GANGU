# GANGU Environment Variables Template
# Copy this to .env and fill in your actual values

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: LangSmith for tracing (set to false if not using)
export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com
export LANGSMITH_API_KEY=your_langsmith_api_key_here
export LANGSMITH_PROJECT="GANGU"

# Optional: Zepto MCP Configuration
ZEPTO_PHONE_NUMBER=your_phone_number
ZEPTO_DEFAULT_ADDRESS=Hostel-BH3 IIIT ALLAHABAD JHALWA 

# MongoDB (uses default if not set)
MONGODB_URI=mongodb://localhost:27017
