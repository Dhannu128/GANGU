# GANGU Environment Variables Template
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control.

# Required: Google Gemini API Key
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: additional Gemini keys for rate-limit rotation
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional: LangSmith for tracing (set LANGSMITH_TRACING=false to disable)
# Get a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=GANGU

# Optional: Zepto MCP Configuration
ZEPTO_PHONE_NUMBER=your_10_digit_phone_number
ZEPTO_DEFAULT_ADDRESS=Home

# Optional: OpenAI (used only for Whisper voice transcription)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB (uses default if not set)
MONGODB_URI=mongodb://localhost:27017
