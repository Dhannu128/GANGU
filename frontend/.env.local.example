# Local dev — point at your local FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Production (Vercel) — point at your Render backend, e.g.
# NEXT_PUBLIC_API_URL=https://gangu-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://gangu-api.onrender.com

# Firebase web app configuration (Firebase Console > Project settings > Your apps)
# These NEXT_PUBLIC values identify the Firebase web app; never use an Admin SDK
# private key or service-account JSON in the frontend.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id
